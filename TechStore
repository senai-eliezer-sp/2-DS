<?xml version="1.0" encoding="UTF-8"?>
<system name="TechStore">

    <actors>
        <actor id="A1" name="Cliente"/>
        <actor id="A2" name="AtendenteLogistica"/>
    </actors>

    <useCases>
        <useCase id="UC1" name="RealizarLogin"/>
        <useCase id="UC2" name="FinalizarCompra"/>
        <useCase id="UC3" name="ConsultarStatusPedido"/>
        <useCase id="UC4" name="AtualizarRastreamento"/>
    </useCases>

    <relationships>
        <!-- Relações de inclusão obrigatória -->
        <include from="UC2" to="UC1"/>
        <include from="UC3" to="UC1"/>
        <include from="UC4" to="UC1"/>
    </relationships>

    <associations>
        <!-- Cliente -->
        <association actor="A1" useCase="UC2"/>
        <association actor="A1" useCase="UC3"/>

        <!-- Atendente de Logística -->
        <association actor="A2" useCase="UC4"/>
    </associations>

</system>
